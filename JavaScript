const checkmarked = document.querySelector('.hjerte1');
checkmarked.addEventListener('click', checkedfunction);
function checkedfunction(){
    checkmarked.style.backgroundColor='red';
}

const checkmarked1 = document.querySelectorAll('.hjerte');

checkmarked1.forEach(function (element) {
    element.addEventListener('click', function(){
        element.style.backgroundColor='red';
    })
})
